---
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getBlog, getTil } from '../lib/posts';

const blog = (await getBlog()).slice(0, 5);
const til = (await getTil()).slice(0, 5);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<div class="page-head">
		<h1>프론트엔드 8년, 이제 백엔드도 합니다</h1>
		<p>일하며 배운 것을 긴 글과 짧은 메모로 남깁니다</p>
	</div>

	<section>
		<div class="section-head">
			<h2>글</h2>
			<a href="/blog">전체 보기</a>
		</div>
		<PostList posts={blog} />
	</section>

	<section>
		<div class="section-head">
			<h2>TIL</h2>
			<a href="/til">전체 보기</a>
		</div>
		<PostList posts={til} />
	</section>
</Base>
<style>
	section + section {
		margin-top: 48px;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 8px;
		padding-bottom: 8px;
		border-bottom: 1px solid var(--line);
	}
	.section-head h2 {
		font-size: 14px;
		font-weight: 500;
		color: var(--text-2);
	}
	.section-head a {
		font-size: 13px;
		color: var(--text-3);
	}
	.section-head a:hover {
		color: var(--accent);
	}
</style>
